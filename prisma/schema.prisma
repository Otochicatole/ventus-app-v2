// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id         String   @id @default(cuid())
  name       String
  lastName   String
  email      String
  phone      String
  date       DateTime
  time       String
  confirmed  Boolean  @default(false)
  notes      String?
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Location {
  id               String            @id @default(cuid())
  name             String
  address          String
  latitude         Float?
  longitude        Float?
  shifts           Shift[]
  timeSlots        TimeSlot[]
  unavailableDates UnavailableDate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model UnavailableDate {
  id         String   @id @default(cuid())
  date       DateTime
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([locationId, date])
}

model TimeSlot {
  id         String   @id @default(cuid())
  time       String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([locationId, time])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientPaidService {
  id                String   @id @default(cuid())
  fullName          String
  payment           Float
  description       String?
  servicesPerformed String[]
  productsBought    String[] @default([])
  paidAt            DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fullName])
  @@index([paidAt])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int?     @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model FixedExpense {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  description String?
  startsAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
  @@index([name])
}

model Expense {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  description String?
  spentAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spentAt])
  @@index([name])
}

model Review {
  id        String   @id @default(cuid())
  author    String   @default("Anónimo")
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

